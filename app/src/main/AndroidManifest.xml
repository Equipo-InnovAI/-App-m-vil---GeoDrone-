<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GeodroneApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Geodrone">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/register_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="@string/home_title" />

        <activity
            android:name=".ProjectsActivity"
            android:exported="false"
            android:label="@string/projects_title" />

        <activity
            android:name=".ProjectFormActivity"
            android:exported="false"
            android:label="@string/project_form_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FlightsActivity"
            android:exported="false"
            android:label="@string/flights_title" />

        <activity
            android:name=".FlightFormActivity"
            android:exported="false"
            android:label="@string/flight_form_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ImageUploadActivity"
            android:exported="false"
            android:label="@string/image_upload_title" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="@string/profile_title" />

        <activity
            android:name=".CalculationActivity"
            android:exported="false"
            android:label="Proceso de Cálculos" />

        <activity
            android:name=".ResultsActivity"
            android:exported="false"
            android:label="Resultados del Análisis" />

    </application>

</manifest>
